# Copy to .env and fill in. .env is git-ignored and never committed.

# Linear personal API key (Linear → Settings → API → Personal API keys)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# The Linear team UUID to run against (the seed script and benchmark use this)
LINEAR_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Anthropic API key for the agent under test (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
